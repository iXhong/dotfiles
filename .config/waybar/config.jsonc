// -*- mode: jsonc -*-
{
    // "layer": "top", // Waybar at top layer
    // "position": "bottom", // Waybar position (top|bottom|left|right)
    "height": 30, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 4, // Gaps between modules (4px)
    // Choose the order of the modules
    "modules-left": [
        "sway/workspaces",
	    "wlr/taskbar"
    ],
    "modules-center": [
        "sway/window"
    ],
    "modules-right": [
        "custom/theme",
        "clock",
        "pulseaudio",
        "cpu",
        "memory",
        "battery",
	    "network",
        "tray",
    ],
    // Modules configuration
    // "sway/workspaces": {
    //     "disable-scroll": true,
    //     "all-outputs": true,
    //     "warp-on-scroll": false,
    //     "format": "{name}: {icon}",
    //     "format-icons": {
    //         "1": "",
    //         "2": "",
    //         "3": "",
    //         "4": "",
    //         "5": "",
    //         "urgent": "",
    //         "focused": "",
    //         "default": ""
    //     }
    // },
    "tray": {
        "icon-size": 22,
        "spacing": 10
    },
    "clock": {
        "format":"{:%a|%b-%d|%H:%M}"
    },
    "cpu": {
        "format": "CPU {usage}%",
        "tooltip": false
    },
    "memory": {
        "format": "MEM {}%"
    },
    "battery": {
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "BAT {capacity}%",
        "format-full": "BAT {capacity}%",
        "format-charging": "BAT {capacity}% ⚡",
        "format-plugged": "BAT {capacity}%",
        "format-alt": "BAT {time}",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",

    },
    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "interval": 3,//second
        "format-wifi": "↓{bandwidthDownBytes:>} ↑{bandwidthUpBytes:>}",
        "format-ethernet": "{ipaddr}/{cidr}",
        "tooltip-format": "{ifname} via {gwaddr}",
        "format-linked": "{ifname}",
        "format-disconnected": "off",
        "tooltip-format": "{essid} {ifname}\n{ipaddr}/{cidr}\ngateway\t{gwaddr}"
        //"format-alt": "{ifname}: {ipaddr}/{cidr}"
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "VOL {volume}% {format_source}",
        "format-bluetooth": "VOL {volume}% BT {format_source}",
        "format-bluetooth-muted": "VOL MUTED BT {format_source}",
        "format-muted": "VOL MUTED {format_source}",
        "format-source": "{volume}% MIC",
        "format-source-muted": "MIC OFF",
        "on-click": "pavucontrol",
	"on-click-right":"blueman-manager"
    },
    "wlr/taskbar": {
        "format": "{name}",
        "icon-size": 22,
        "icon-theme": "Adwaita",
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close"
    },
    "custom/theme":{
        "format":"☀",
        "icon-size":20,
        "tooltip":false,
        "menu":"on-click",
        "menu-file":"$HOME/.config/waybar/menu/theme_menu.xml",
        "menu-actions":{
            "light":"exec $HOME/.config/waybar/scripts/light.sh",
            "dark":"exec $HOME/.config/waybar/scripts/dark.sh"
        }
    },
}
